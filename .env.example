# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Cấu hình Postgres / Supabase (src/db/index.ts) ---

# SQL_HOST: host CSDL, dùng cho ứng dụng lúc chạy.
SQL_HOST="db.your-project-ref.supabase.co"
# SQL_USER: user CSDL dùng cho ứng dụng lúc chạy (quyền hạn chế, không phải admin).
SQL_USER="postgres"
# SQL_PASSWORD: mật khẩu tương ứng SQL_USER. Đây là giá trị giả, không dùng mật khẩu thật.
SQL_PASSWORD="CHANGE_ME"
# SQL_DB_NAME: tên database.
SQL_DB_NAME="postgres"

# SQL_ADMIN_USER / SQL_ADMIN_PASSWORD: cặp tài khoản riêng (khác SQL_USER/SQL_PASSWORD
# ở trên) dùng bởi drizzle-kit khi chạy migration — xem src/db/drizzle.config.ts.
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="CHANGE_ME"

# SQL_SSL: mặc định BẬT SSL (bắt buộc khi dùng Supabase). Đặt "false" nếu chạy
# Postgres cục bộ không hỗ trợ SSL trong lúc phát triển.
SQL_SSL="true"

# --- Thời gian sống của cache, đơn vị mili-giây ---
# Để trống hoặc 0 = TẮT cache hoàn toàn. Đây là mặc định, và là cấu hình
# dùng cho giai đoạn demo với lãnh đạo (mọi số liệu phản hồi tức thì).
#
# Sau khi nghiệm thu, bật giá trị production bằng cách bỏ chú thích bên dưới.
# Đổi giữa hai giai đoạn CHỈ cần sửa file này và khởi động lại, không sửa code.

CACHE_TTL_STATS="0"          # production khuyến nghị: 600000  (10 phút)
CACHE_TTL_LEADERBOARD="0"    # production khuyến nghị: 60000   (60 giây)
CACHE_TTL_UNITS="0"          # production khuyến nghị: 900000  (15 phút)
